# ====================================================================
# HACKFORGE ENVIRONMENT CONFIGURATION
# ====================================================================

# Google Gemini API Key (for LLM generation, Gemini Live voice, and pgvector embeddings)
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase PostgreSQL + pgvector Configuration
# Get yours at https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
